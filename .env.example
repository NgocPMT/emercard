PUBLIC_APP_ENV=local
PUBLIC_APP_NAME=EmerCard
PUBLIC_SITE_URL=https://app.emercard.id.vn
PUBLIC_API_BASE_PATH=/api
PUBLIC_DEMO_DATA_NOTICE=

# Local FastAPI target used by Astro's same-origin `/api/*` proxy and Playwright auth tests.
EMERCARD_API_PROXY_TARGET=http://127.0.0.1:8000
# Backend OpenAPI snapshot used by `npm run api:sync`.
EMERCARD_OPENAPI_URL=http://127.0.0.1:8000/openapi.json
