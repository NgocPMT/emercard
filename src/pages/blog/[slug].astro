---
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/blog/Breadcrumbs.astro";
import BlogCard from "../../components/blog/BlogCard.astro";
import { getBlogPostBySlug, getBlogPostSlugs, getBlogPosts } from "../../data/blog";

export function getStaticPaths() {
  return getBlogPostSlugs().map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const post = getBlogPostBySlug(slug ?? "");
const posts = getBlogPosts();
const relatedPosts = posts.filter((entry) => entry.slug !== post?.slug).slice(0, 2);

const published = post
  ? new Intl.DateTimeFormat("en", {
      month: "long",
      day: "numeric",
      year: "numeric",
    }).format(post.pubDate)
  : "";
---

<Base title={post?.title ?? "Blog"}>
  {
    post ? (
      <article class="mx-auto max-w-4xl px-6 py-16 lg:px-8 lg:py-24">
        <Breadcrumbs
          items={[
            { label: "Inicio", href: "/" },
            { label: "Blog", href: "/blog" },
            { label: post.title },
          ]}
        />

        {post.coverUrl ? (
          <img src={post.coverUrl} alt={post.coverAlt} class="mb-8 h-[28rem] w-full rounded-3xl object-cover shadow-lg" loading="eager" />
        ) : null}

        <div class="mb-4 flex flex-wrap items-center gap-3 text-xs font-semibold uppercase tracking-[0.16em] text-sky-700">
          <span>{published}</span>
          <span class="h-1 w-1 rounded-full bg-sky-400"></span>
          <span>{post.author}</span>
        </div>

        <h1 class="text-4xl font-black tracking-[-0.04em] text-slate-950 md:text-5xl">
          {post.title}
        </h1>

        <div class="prose prose-lg prose-emerald mt-8 max-w-none text-slate-700">
          {post.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>

        <a
          href="/blog"
          class="mt-8 inline-flex items-center gap-2 rounded-full bg-sky-600 px-6 py-3 text-sm font-semibold text-white transition hover:bg-sky-700"
        >
          Quay lại bài viết
        </a>

        {
          relatedPosts.length > 0 && (
            <section class="mt-16">
              <h2 class="mb-6 text-2xl font-bold tracking-tight text-slate-900 md:text-3xl">Bài viết liên quan</h2>

              <div class="grid gap-6 md:grid-cols-2">
                {relatedPosts.map((relatedPost) => <BlogCard post={relatedPost} />)}
              </div>
            </section>
          )
        }
      </article>
    ) : (
      <article class="mx-auto max-w-4xl px-6 py-20">
        <Breadcrumbs
          items={[
            { label: "Inicio", href: "/" },
            { label: "Blog", href: "/blog" },
          ]}
        />
        <h1 class="text-4xl font-black tracking-[-0.04em] text-slate-950 md:text-5xl">Bài viết không tồn tại</h1>
        <p class="mt-4 text-slate-600">Vui lòng quay lại danh sách blog.</p>
      </article>
    )
  }
</Base>
