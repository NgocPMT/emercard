---
import Base from "../../layouts/Base.astro";
import BlogCard from "../../components/blog/BlogCard.astro";
import Breadcrumbs from "../../components/blog/Breadcrumbs.astro";
import Pagination from "../../components/blog/Pagination.astro";
import { getBlogPosts } from "../../data/blog";

const url = new URL(Astro.request.url);
const requestedPage = Number.parseInt(url.searchParams.get("page") ?? "1", 10);
const currentPage = Number.isFinite(requestedPage) && requestedPage > 0 ? requestedPage : 1;

const posts = getBlogPosts();
const postsPerPage = 6;
const totalPages = Math.max(1, Math.ceil(posts.length / postsPerPage));
const safePage = Math.min(currentPage, totalPages);
const start = (safePage - 1) * postsPerPage;
const currentPosts = posts.slice(start, start + postsPerPage);
---

<Base title="Blog">
  <section class="mx-auto max-w-7xl px-6 py-16 lg:px-8 lg:py-24">
    <div class="mx-auto max-w-3xl text-center">
      <Breadcrumbs
        items={[
          { label: "Inicio", href: "/" },
          { label: "Blog", href: "/blog" },
        ]}
      />

      <p class="mb-4 text-sm font-semibold uppercase tracking-[0.18em] text-sky-700">Blog</p>
      <h1 class="text-4xl font-black tracking-[-0.04em] text-slate-950 md:text-5xl">Kiến thức giúp bạn chủ động chăm sóc sức khỏe.</h1>
      <p class="mx-auto mt-4 max-w-2xl text-base leading-7 text-slate-600 md:text-lg">Những bài viết ngắn gọn về phòng ngừa, chăm sóc và các thói quen tốt mỗi ngày.</p>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      {currentPosts.map((post) => <BlogCard post={post} />)}
    </div>

    <Pagination currentPage={safePage} totalPages={totalPages} baseUrl="/blog" />
  </section>
</Base>
