---
import { publicEnv } from "../../config/public-env";
import EmergencyLayout from "../../layouts/EmergencyLayout.astro";

const demoNotice = publicEnv.PUBLIC_DEMO_DATA_NOTICE ?? "Dữ liệu minh họa chỉ dùng cho bản demo EmerCard.";
---

<EmergencyLayout>
  <main class="mx-auto flex min-h-screen max-w-2xl items-center px-4 py-8 sm:px-6">
    <section class="w-full rounded-[1.5rem] border border-border bg-card p-6 shadow-sm sm:p-8">
      <p class="text-sm font-semibold tracking-wide text-primary">EMERCARD</p>
      <h1 class="mt-2 text-2xl font-bold text-foreground">Thông tin y tế khẩn cấp</h1>

      <div id="loading" role="status" class="mt-8 text-muted-foreground">Đang tải thông tin khẩn cấp…</div>

      <div id="not-found" class="mt-8 hidden" role="alert">
        <h2 class="text-lg font-semibold text-foreground">Không tìm thấy hồ sơ công khai</h2>
        <p class="mt-2 text-muted-foreground">Vui lòng kiểm tra lại đường dẫn hoặc yêu cầu chủ thẻ cung cấp liên kết mới.</p>
      </div>

      <div id="disabled" class="mt-8 hidden" role="alert">
        <h2 class="text-lg font-semibold text-foreground">Liên kết hồ sơ đã bị vô hiệu hóa</h2>
        <p class="mt-2 text-muted-foreground">Hồ sơ công khai này không còn được chia sẻ tại liên kết hiện tại.</p>
      </div>

      <div id="not-ready" class="mt-8 hidden" role="alert">
        <h2 class="text-lg font-semibold text-foreground">Hồ sơ công khai chưa sẵn sàng</h2>
        <p class="mt-2 text-muted-foreground">Hồ sơ hiện tại chưa đáp ứng điều kiện hiển thị công khai.</p>
      </div>

      <div id="service-unavailable" class="mt-8 hidden" role="alert">
        <h2 class="text-lg font-semibold text-foreground">Không thể tải hồ sơ công khai</h2>
        <p class="mt-2 text-muted-foreground">Máy chủ tạm thời không phản hồi. Vui lòng thử lại sau.</p>
        <button id="retry" type="button" class="mt-4 rounded-full bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground">
          Thử lại
        </button>
      </div>

      <article id="profile" class="mt-8 hidden" aria-live="polite">
        <header class="space-y-2">
          <h2 id="display-name" class="text-2xl font-bold text-foreground"></h2>
          <p id="identity-meta" class="text-sm text-muted-foreground"></p>
        </header>

        <dl class="mt-6 grid gap-5">
          <div id="blood-type-row" class="rounded-[1rem] border border-border p-4">
            <dt class="text-sm font-semibold text-foreground">Nhóm máu</dt>
            <dd id="blood-type" class="mt-1 text-lg font-bold text-primary"></dd>
          </div>
          <div id="allergies-row" class="rounded-[1rem] border border-border p-4">
            <dt class="font-semibold text-foreground">Dị ứng quan trọng</dt>
            <dd id="allergies" class="mt-1 whitespace-pre-line text-muted-foreground"></dd>
          </div>
          <div id="conditions-row" class="rounded-[1rem] border border-border p-4">
            <dt class="font-semibold text-foreground">Tình trạng bệnh quan trọng</dt>
            <dd id="conditions" class="mt-1 whitespace-pre-line text-muted-foreground"></dd>
          </div>
          <div id="medications-row" class="rounded-[1rem] border border-border p-4">
            <dt class="font-semibold text-foreground">Thuốc đang sử dụng</dt>
            <dd id="medications" class="mt-1 whitespace-pre-line text-muted-foreground"></dd>
          </div>
          <div id="note-row" class="rounded-[1rem] border border-border p-4">
            <dt class="font-semibold text-foreground">Ghi chú khẩn cấp</dt>
            <dd id="note" class="mt-1 whitespace-pre-line text-muted-foreground"></dd>
          </div>
        </dl>

        <section id="contacts-section" class="mt-8 hidden" aria-labelledby="contacts-title">
          <h3 id="contacts-title" class="text-lg font-semibold text-foreground">Liên hệ khẩn cấp</h3>
          <ul id="contacts" class="mt-3 space-y-3"></ul>
        </section>

        <section class="mt-8 rounded-[1rem] border border-border bg-muted/30 p-4">
          <p class="text-sm font-semibold text-foreground">Cập nhật gần nhất</p>
          <p id="updated-at" class="mt-1 text-sm text-muted-foreground"></p>
        </section>

        <p id="demo-notice" class="mt-6 text-sm text-muted-foreground">{demoNotice}</p>
      </article>
    </section>
  </main>

  <script type="module">
    import { extractEmergencyToken, getPublicEmergencyProfile } from "../../api/public-emergency";
    import { bloodTypeLabel, genderLabel } from "../../lib/profile-labels";

    const loading = document.querySelector("#loading");
    const notFound = document.querySelector("#not-found");
    const disabled = document.querySelector("#disabled");
    const notReady = document.querySelector("#not-ready");
    const serviceUnavailable = document.querySelector("#service-unavailable");
    const retryButton = document.querySelector("#retry");
    const profileElement = document.querySelector("#profile");

    const hide = (element) => element?.classList.add("hidden");
    const show = (element) => element?.classList.remove("hidden");
    const hideAll = () => {
      for (const element of [loading, notFound, disabled, notReady, serviceUnavailable, profileElement]) {
        hide(element);
      }
    };

    const setText = (selector, value) => {
      const element = document.querySelector(selector);
      if (element) element.textContent = value;
    };

    const setSectionText = (rowId, valueId, value) => {
      const row = document.querySelector(`#${rowId}`);
      const element = document.querySelector(`#${valueId}`);
      if (!row || !element) return;
      row.classList.remove("hidden");
      if (typeof value !== "string" || !value.trim()) {
        element.textContent = "Chưa cung cấp";
        return;
      }
      element.textContent = value;
    };

    const setListText = (rowId, valueId, values) => {
      const row = document.querySelector(`#${rowId}`);
      const element = document.querySelector(`#${valueId}`);
      if (!row || !element) return;
      row.classList.remove("hidden");
      if (!Array.isArray(values) || values.length === 0) {
        element.textContent = "Chưa cung cấp";
        return;
      }
      element.textContent = values.join(" • ");
    };

    const renderContacts = (contacts) => {
      const container = document.querySelector("#contacts");
      const section = document.querySelector("#contacts-section");
      if (!container || !section) return;
      container.replaceChildren();
      if (!Array.isArray(contacts) || contacts.length === 0) {
        hide(section);
        return;
      }
      for (const contact of contacts) {
        if (!contact || typeof contact.phone !== "string") continue;
        const item = document.createElement("li");
        item.className = "rounded-[1rem] border border-border p-4";

        const name = document.createElement("p");
        name.className = "font-semibold text-foreground";
        name.textContent = contact.name || "Liên hệ khẩn cấp";
        item.append(name);

        const relationship = document.createElement("p");
        relationship.className = "mt-1 text-sm text-muted-foreground";
        relationship.textContent = contact.relationship || "Chưa cung cấp";
        item.append(relationship);

        const call = document.createElement("a");
        call.className = "mt-3 inline-flex min-h-11 items-center rounded-full bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground";
        call.href = `tel:${encodeURIComponent(contact.phone)}`;
        call.textContent = "Gọi liên hệ";
        item.append(call);
        container.append(item);
      }
      if (container.childElementCount > 0) {
        show(section);
      } else {
        hide(section);
      }
    };

    const renderProfile = (profile) => {
      hideAll();
      const displayName = typeof profile.display_name === "string" && profile.display_name.trim() ? profile.display_name.trim() : "Thông tin khẩn cấp";
      setText("#display-name", displayName);
      const meta = [];
      if (typeof profile.birth_year === "number") meta.push(`Năm sinh ${profile.birth_year}`);
      if (typeof profile.gender === "string" && profile.gender) meta.push(`Giới tính ${genderLabel(profile.gender)}`);
      setText("#identity-meta", meta.length ? meta.join(" • ") : "Chưa cung cấp thêm thông tin định danh");
      setSectionText("blood-type-row", "blood-type", bloodTypeLabel(typeof profile.blood_type === "string" ? profile.blood_type : null));
      setListText("allergies-row", "allergies", profile.critical_allergies);
      setListText("conditions-row", "conditions", profile.important_conditions);
      setListText("medications-row", "medications", profile.critical_medications);
      setSectionText("note-row", "note", profile.emergency_note);
      renderContacts(profile.emergency_contacts);
      setText("#updated-at", new Date(profile.profile_updated_at).toLocaleString("vi-VN"));
      show(profileElement);
    };

    const renderFailure = (kind) => {
      hideAll();
      switch (kind) {
        case "not_found":
          show(notFound);
          break;
        case "disabled":
          show(disabled);
          break;
        case "not_ready":
          show(notReady);
          break;
        default:
          show(serviceUnavailable);
          break;
      }
    };

    const load = async () => {
      hideAll();
      show(loading);
      const token = extractEmergencyToken(window.location.pathname);
      if (!token) {
        renderFailure("not_found");
        return;
      }
      const result = await getPublicEmergencyProfile(token);
      if (result.kind === "available") {
        renderProfile(result.profile);
        return;
      }
      renderFailure(result.kind);
    };

    retryButton?.addEventListener("click", () => {
      void load();
    });

    void load();
  </script>
</EmergencyLayout>
