---
import "../styles/global.css";

const { title = "EmerCard | Authentication", description = "EmerCard authentication" } = Astro.props;
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="bg-background text-foreground">
    <main class="soft-grid flex min-h-screen items-center justify-center px-4 py-8 sm:px-6 lg:px-8">
      <slot />
    </main>
  </body>
</html>
