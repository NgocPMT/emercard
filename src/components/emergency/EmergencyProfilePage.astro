<main
  class="mx-auto flex min-h-screen max-w-3xl items-center px-4 py-8 sm:px-6 lg:py-12"
>
  <section
    class="w-full rounded-[2rem] border border-primary/15 bg-card p-6 shadow-[var(--shadow-lifted)] sm:p-10"
  >
    <div class="mb-8 flex items-center gap-3">
      <img src="/logo.png" alt="EmerCard" class="h-10 w-10 rounded-2xl border border-primary/20 bg-white object-contain" />
      <p class="text-sm font-extrabold tracking-[0.16em] text-primary">EMERCARD</p>
    </div>
    <h1 class="text-3xl font-black tracking-[-0.035em] text-foreground sm:text-4xl">
      Thông tin y tế khẩn cấp
    </h1>

    <div id="loading" role="status" class="mt-8 text-muted-foreground">
      Đang tải thông tin khẩn cấp…
    </div>
    <div id="not-found" class="mt-8 hidden" role="alert">
      <h2 class="text-lg font-semibold text-foreground">
        Không tìm thấy hồ sơ công khai
      </h2><p class="mt-2 text-muted-foreground">
        Vui lòng kiểm tra lại đường dẫn hoặc yêu cầu chủ thẻ cung cấp liên kết
        mới.
      </p>
    </div>
    <div id="disabled" class="mt-8 hidden" role="alert">
      <h2 class="text-lg font-semibold text-foreground">
        Liên kết hồ sơ đã bị vô hiệu hóa
      </h2><p class="mt-2 text-muted-foreground">
        Hồ sơ công khai này không còn được chia sẻ tại liên kết hiện tại.
      </p>
    </div>
    <div id="pending" class="mt-8 hidden" role="alert">
      <h2 class="text-lg font-semibold text-foreground">
        Liên kết hồ sơ đang chờ kích hoạt
      </h2><p class="mt-2 text-muted-foreground">
        Liên kết này chưa sẵn sàng để hiển thị công khai.
      </p>
    </div>
    <div id="revoked" class="mt-8 hidden" role="alert">
      <h2 class="text-lg font-semibold text-foreground">
        Liên kết hồ sơ đã bị thu hồi
      </h2><p class="mt-2 text-muted-foreground">
        Liên kết hiện tại không còn hiệu lực công khai.
      </p>
    </div>
    <div id="expired" class="mt-8 hidden" role="alert">
      <h2 class="text-lg font-semibold text-foreground">
        Liên kết hồ sơ đã hết hạn
      </h2><p class="mt-2 text-muted-foreground">
        Liên kết này đã quá thời hạn hiển thị công khai.
      </p>
    </div>
    <div id="not-ready" class="mt-8 hidden" role="alert">
      <h2 class="text-lg font-semibold text-foreground">
        Hồ sơ công khai chưa sẵn sàng
      </h2><p class="mt-2 text-muted-foreground">
        Hồ sơ hiện tại chưa đáp ứng điều kiện hiển thị công khai.
      </p>
    </div>
    <div id="service-unavailable" class="mt-8 hidden" role="alert">
      <h2 class="text-lg font-semibold text-foreground">
        Không thể tải hồ sơ công khai
      </h2><p class="mt-2 text-muted-foreground">
        Máy chủ tạm thời không phản hồi. Vui lòng thử lại sau.
      </p><button
        id="retry"
        type="button"
        class="mt-4 rounded-full bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground"
        >Thử lại</button>
    </div>

    <article id="profile" class="mt-10 hidden" aria-live="polite">
      <header class="space-y-2">
        <h2 id="display-name" class="text-2xl font-bold text-foreground"></h2><p
          id="identity-meta"
          class="text-sm text-muted-foreground"
        >
        </p>
      </header>
      <dl class="mt-6 grid gap-5">
        <div
          id="blood-type-row"
          class="rounded-[1rem] border border-border p-4"
        >
          <dt class="text-sm font-semibold text-foreground">Nhóm máu</dt><dd
            id="blood-type"
            class="mt-1 text-lg font-bold text-primary"
          >
          </dd>
        </div>
        <div id="allergies-row" class="rounded-[1rem] border border-border p-4">
          <dt class="font-semibold text-foreground">Dị ứng quan trọng</dt><dd
            id="allergies"
            class="mt-1 whitespace-pre-line text-muted-foreground"
          >
          </dd>
        </div>
        <div
          id="conditions-row"
          class="rounded-[1rem] border border-border p-4"
        >
          <dt class="font-semibold text-foreground">
            Tình trạng bệnh quan trọng
          </dt><dd
            id="conditions"
            class="mt-1 whitespace-pre-line text-muted-foreground"
          >
          </dd>
        </div>
        <div
          id="medications-row"
          class="rounded-[1rem] border border-border p-4"
        >
          <dt class="font-semibold text-foreground">Thuốc đang sử dụng</dt><dd
            id="medications"
            class="mt-1 whitespace-pre-line text-muted-foreground"
          >
          </dd>
        </div>
        <div id="note-row" class="rounded-[1rem] border border-border p-4">
          <dt class="font-semibold text-foreground">Ghi chú khẩn cấp</dt><dd
            id="note"
            class="mt-1 whitespace-pre-line text-muted-foreground"
          >
          </dd>
        </div>
      </dl>
      <section
        id="contacts-section"
        class="mt-8 hidden"
        aria-labelledby="contacts-title"
      >
        <h3 id="contacts-title" class="text-lg font-semibold text-foreground">
          Liên hệ khẩn cấp
        </h3><ul id="contacts" class="mt-3 space-y-3"></ul>
      </section>
      <section class="mt-8 rounded-[1rem] border border-border bg-muted/30 p-4">
        <p class="text-sm font-semibold text-foreground">Cập nhật gần nhất</p><p
          id="updated-at"
          class="mt-1 text-sm text-muted-foreground"
        >
        </p>
      </section>
    </article>
  </section>
</main>

<script>
  import {
    extractEmergencyToken,
    getPublicEmergencyProfile,
  } from "../../api/public-emergency";
  import { bloodTypeLabel, genderLabel } from "../../lib/profile-labels";

  const loading = document.querySelector("#loading");
  const notFound = document.querySelector("#not-found");
  const disabled = document.querySelector("#disabled");
  const notReady = document.querySelector("#not-ready");
  const pending = document.querySelector("#pending");
  const revoked = document.querySelector("#revoked");
  const expired = document.querySelector("#expired");
  const serviceUnavailable = document.querySelector("#service-unavailable");
  const retryButton = document.querySelector("#retry");
  const profileElement = document.querySelector("#profile");

  const hide = (element) => element?.classList.add("hidden");
  const show = (element) => element?.classList.remove("hidden");
  const hideAll = () => {
    for (const element of [
      loading,
      notFound,
      disabled,
      pending,
      revoked,
      expired,
      notReady,
      serviceUnavailable,
      profileElement,
    ])
      hide(element);
  };
  const setText = (selector, value) => {
    const element = document.querySelector(selector);
    if (element) element.textContent = value;
  };
  const setSectionText = (rowId, valueId, value) => {
    const row = document.querySelector(`#${rowId}`);
    const element = document.querySelector(`#${valueId}`);
    if (!row || !element) return;
    row.classList.remove("hidden");
    element.textContent =
      typeof value === "string" && value.trim() ? value : "Chưa cung cấp";
  };
  const setListText = (rowId, valueId, values) => {
    const row = document.querySelector(`#${rowId}`);
    const element = document.querySelector(`#${valueId}`);
    if (!row || !element) return;
    row.classList.remove("hidden");
    element.textContent =
      Array.isArray(values) && values.length
        ? values.join(" • ")
        : "Chưa cung cấp";
  };
  const renderContacts = (contacts) => {
    const container = document.querySelector("#contacts");
    const section = document.querySelector("#contacts-section");
    if (!container || !section) return;
    container.replaceChildren();
    for (const contact of Array.isArray(contacts) ? contacts : []) {
      if (!contact || typeof contact.phone !== "string") continue;
      const item = document.createElement("li");
      item.className = "rounded-[1rem] border border-border p-4";
      const row = document.createElement("div");
      row.className = "flex items-center justify-between gap-4";
      const details = document.createElement("div");
      details.className = "min-w-0 flex-1";
      const name = document.createElement("p");
      name.className = "truncate font-semibold text-foreground";
      name.textContent = contact.name || "Liên hệ khẩn cấp";
      const relationship = document.createElement("p");
      relationship.className = "mt-1 text-sm text-muted-foreground";
      relationship.textContent = contact.relationship || "Chưa cung cấp";
      details.append(name, relationship);
      const call = document.createElement("a");
      call.className =
        "inline-flex min-h-11 shrink-0 items-center rounded-full bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground";
      call.href = `tel:${encodeURIComponent(contact.phone)}`;
      call.textContent = "Gọi liên hệ";
      row.append(details, call);
      item.append(row);
      container.append(item);
    }
    if (container.childElementCount) show(section);
    else hide(section);
  };
  const renderProfile = (profile) => {
    hideAll();
    setText(
      "#display-name",
      typeof profile.display_name === "string" && profile.display_name.trim()
        ? profile.display_name.trim()
        : "Thông tin khẩn cấp",
    );
    const meta = [];
    if (typeof profile.birth_year === "number")
      meta.push(`Năm sinh ${profile.birth_year}`);
    if (typeof profile.gender === "string" && profile.gender)
      meta.push(`Giới tính ${genderLabel(profile.gender)}`);
    setText(
      "#identity-meta",
      meta.length ? meta.join(" • ") : "Chưa cung cấp thêm thông tin định danh",
    );
    setSectionText(
      "blood-type-row",
      "blood-type",
      bloodTypeLabel(
        typeof profile.blood_type === "string" ? profile.blood_type : null,
      ),
    );
    setListText("allergies-row", "allergies", profile.critical_allergies);
    setListText("conditions-row", "conditions", profile.important_conditions);
    setListText("medications-row", "medications", profile.critical_medications);
    setSectionText("note-row", "note", profile.emergency_note);
    renderContacts(profile.emergency_contacts);
    setText(
      "#updated-at",
      new Date(profile.profile_updated_at).toLocaleString("vi-VN"),
    );
    show(profileElement);
  };
  const renderFailure = (kind) => {
    hideAll();
    const states = {
      not_found: notFound,
      disabled,
      pending,
      revoked,
      expired,
      not_ready: notReady,
    };
    show(states[kind] ?? serviceUnavailable);
  };
  const load = async () => {
    hideAll();
    show(loading);
    const token = extractEmergencyToken(window.location.pathname);
    if (!token) return renderFailure("not_found");
    const result = await getPublicEmergencyProfile(token);
    if (result.kind === "available") return renderProfile(result.profile);
    renderFailure(result.kind);
  };
  retryButton?.addEventListener("click", () => void load());
  void load();
</script>
