<main
  class="emergency-page min-h-screen py-4 px-3 sm:py-8 sm:px-4 flex justify-center items-start"
>
  <div
    class="phone-frame w-full max-w-[420px]"
  >
    <!-- Status Bar (Mobile feel) -->
    <div class="phone-status-bar" aria-hidden="true">
      <span class="status-time">EMERGENCY</span>
      <div class="status-icons">
        <svg viewBox="0 0 24 24"><path d="M12 3c-4.97 0-9 4.03-9 9 0 2.12.74 4.07 1.97 5.61L12 22l7.03-4.39C20.26 16.07 21 14.12 21 12c0-4.97-4.03-9-9-9z"/></svg>
        <svg viewBox="0 0 24 24"><path d="M12 4C7.31 4 3.07 5.9 0 8.98L12 21 24 8.98C20.93 5.9 16.69 4 12 4z"/></svg>
        <svg viewBox="0 0 24 24"><path d="M15.67 4H14V2h-4v2H8.33C7.6 4 7 4.6 7 5.33v15.33C7 21.4 7.6 22 8.33 22h7.33c.74 0 1.34-.6 1.34-1.33V5.33C17 4.6 16.4 4 15.67 4z"/></svg>
      </div>
    </div>

    <!-- Feedback and Fallback Alerts -->
    <div id="loading" role="status" class="p-6 text-center text-muted">
      Đang tải thông tin khẩn cấp…
    </div>
    <div id="not-found" class="p-6 text-center hidden" role="alert">
      <h2 class="text-base font-semibold text-fg">Không tìm thấy hồ sơ công khai</h2>
      <p class="mt-2 text-sm text-muted">Vui lòng kiểm tra lại đường dẫn hoặc yêu cầu chủ thẻ cung cấp liên kết mới.</p>
    </div>
    <div id="disabled" class="p-6 text-center hidden" role="alert">
      <h2 class="text-base font-semibold text-fg">Liên kết hồ sơ đã bị vô hiệu hóa</h2>
      <p class="mt-2 text-sm text-muted">Hồ sơ công khai này không còn được chia sẻ tại liên kết hiện tại.</p>
    </div>
    <div id="pending" class="p-6 text-center hidden" role="alert">
      <h2 class="text-base font-semibold text-fg">Liên kết hồ sơ đang chờ kích hoạt</h2>
      <p class="mt-2 text-sm text-muted">Liên kết này chưa sẵn sàng để hiển thị công khai.</p>
    </div>
    <div id="revoked" class="p-6 text-center hidden" role="alert">
      <h2 class="text-base font-semibold text-fg">Liên kết hồ sơ đã bị thu hồi</h2>
      <p class="mt-2 text-sm text-muted">Liên kết hiện tại không còn hiệu lực công khai.</p>
    </div>
    <div id="expired" class="p-6 text-center hidden" role="alert">
      <h2 class="text-base font-semibold text-fg">Liên kết hồ sơ đã hết hạn</h2>
      <p class="mt-2 text-sm text-muted">Liên kết này đã quá thời hạn hiển thị công khai.</p>
    </div>
    <div id="not-ready" class="p-6 text-center hidden" role="alert">
      <h2 class="text-base font-semibold text-fg">Hồ sơ công khai chưa sẵn sàng</h2>
      <p class="mt-2 text-sm text-muted">Hồ sơ hiện tại chưa đáp ứng điều kiện hiển thị công khai.</p>
    </div>
    <div id="service-unavailable" class="p-6 text-center hidden" role="alert">
      <h2 class="text-base font-semibold text-fg">Không thể tải hồ sơ công khai</h2>
      <p class="mt-2 text-sm text-muted">Máy chủ tạm thời không phản hồi. Vui lòng thử lại sau.</p>
      <button id="retry" type="button" class="mt-4 rounded-full bg-accent px-4 py-2 text-sm font-semibold text-white">Thử lại</button>
    </div>

    <!-- Direct Emergency Screen Content (NO HEADER / NO NAVBAR) -->
    <article id="profile" class="screen-content hidden" aria-live="polite">
      <!-- Patient Identity & Blood Type Row -->
      <div class="profile-hero-row">
        <div class="patient-identity">
          <h1 id="display-name" class="patient-name">Nguyen Van A</h1>
          <p id="identity-meta" class="patient-meta">Năm sinh 1950 • Giới tính Nam</p>
        </div>
        <div id="blood-type-block" class="blood-type-block">
          <span class="blood-type-caption">Nhóm máu</span>
          <span id="blood-type" class="blood-type-val">B+</span>
        </div>
      </div>

      <!-- Card 1: Dị ứng quan trọng -->
      <div id="allergies-row" class="med-card med-card-danger">
        <div class="med-label">
          <span>Dị ứng quan trọng</span>
          <span class="status-pill status-pill-danger">Nguy cơ sốc</span>
        </div>
        <div id="allergies" class="med-val">Penicillin, Hải Sản</div>
      </div>

      <!-- Card 2: Tình trạng bệnh quan trọng -->
      <div id="conditions-row" class="med-card med-card-warning">
        <div class="med-label">
          <span>Tình trạng bệnh quan trọng</span>
          <span class="status-pill status-pill-warning">Bệnh nền</span>
        </div>
        <div id="conditions" class="med-val">Tiểu Đường, Tăng Huyết Áp</div>
      </div>

      <!-- Card 3: Thuốc đang sử dụng -->
      <div id="medications-row" class="med-card">
        <div class="med-label">Thuốc đang sử dụng</div>
        <div id="medications" class="med-val">Chưa cung cấp</div>
      </div>

      <!-- Card 4: Ghi chú khẩn cấp -->
      <div id="note-row" class="med-card">
        <div class="med-label">Ghi chú khẩn cấp</div>
        <div id="note" class="med-val">Chưa cung cấp</div>
      </div>

      <!-- Card 5: Tình trạng bệnh nhạy cảm (Passphrase Protected) -->
      <div id="private-details-section" class="med-card-sensitive hidden">
        <div class="sensitive-header">
          <div class="sensitive-title-wrap">
            <svg class="sensitive-icon" viewBox="0 0 24 24"><path fill="currentColor" d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/></svg>
            <span class="sensitive-title">Tình trạng bệnh nhạy cảm</span>
          </div>
          <span class="sensitive-pill" id="private-details-pill">
            Yêu cầu mật khẩu
          </span>
        </div>

        <!-- Locked State -->
        <div class="sensitive-locked-state" id="private-details-locked">
          <p class="sensitive-locked-desc">
            Thông tin này được bảo mật riêng tư. Vui lòng nhập cụm mật khẩu (passphrase) được chủ thẻ cung cấp để mở xem.
          </p>
          <div class="sensitive-input-group">
            <input
              class="sensitive-input"
              id="private-access-code"
              type="password"
              placeholder="Nhập passphrase..."
              autocomplete="off"
            />
            <button class="btn-unlock" id="private-unlock-button" type="button">
              Mở Khóa
            </button>
          </div>
          <div class="sensitive-error" id="private-details-error"></div>
        </div>

        <!-- Unlocked State -->
        <div class="sensitive-unlocked-state hidden" id="private-details-unlocked">
          <div class="sensitive-data-list" id="private-details-list"></div>
          <div class="sensitive-unlocked-footer">
            <span class="sensitive-status-msg">
              ✓ Đã mở khóa thành công
            </span>
            <button class="btn-relock" id="private-lock-button" type="button">
              <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/></svg>
              Khóa Lại
            </button>
          </div>
        </div>
      </div>

      <!-- Emergency Contact Section -->
      <div id="contacts-section" class="contact-container hidden">
        <div class="contact-section-title">Liên hệ khẩn cấp</div>
        <div id="contacts" class="flex flex-col gap-2"></div>
      </div>

      <!-- SOS Trigger Button -->
      <div class="flex flex-col gap-2">
        <button class="btn-sos-trigger" id="sos-trigger-button" type="button">
          <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>
          Gửi Báo Động SOS
        </button>
        <p
          id="location-alert-status"
          class="text-center text-xs text-muted"
          role="status"
          aria-live="polite"
        >
        </p>
      </div>
    </article>
  </div>
</main>

<script>
  import {
    extractEmergencyToken,
    getPublicEmergencyProfile,
    sendPublicEmergencyLocationAlert,
  } from "../../api/public-emergency";
  import { bloodTypeLabel, genderLabel } from "../../lib/profile-labels";
  import { decryptPrivateProfileWithAccessCode } from "../../lib/private-profile-crypto";

  const loading = document.querySelector("#loading");
  const notFound = document.querySelector("#not-found");
  const disabled = document.querySelector("#disabled");
  const notReady = document.querySelector("#not-ready");
  const pending = document.querySelector("#pending");
  const revoked = document.querySelector("#revoked");
  const expired = document.querySelector("#expired");
  const serviceUnavailable = document.querySelector("#service-unavailable");
  const retryButton = document.querySelector("#retry");
  const profileElement = document.querySelector("#profile");
  const sosTriggerButton = document.querySelector("#sos-trigger-button");
  const locationAlertStatus = document.querySelector("#location-alert-status");
  const privateDetailsSection = document.querySelector(
    "#private-details-section",
  );
  const privateDetailsLocked = document.querySelector(
    "#private-details-locked",
  );
  const privateDetailsUnlocked = document.querySelector(
    "#private-details-unlocked",
  );
  const privateDetailsList = document.querySelector("#private-details-list");
  const privateDetailsPill = document.querySelector("#private-details-pill");
  const privateDetailsError = document.querySelector("#private-details-error");
  const privateAccessCode = document.querySelector("#private-access-code");
  const privateUnlockButton = document.querySelector("#private-unlock-button");
  const privateLockButton = document.querySelector("#private-lock-button");

  let privateEnvelope = null;
  let privateProfileId = null;
  let privateUnlockBusy = false;
  let locationAlertBusy = false;

  const hide = (element) => element?.classList.add("hidden");
  const show = (element) => element?.classList.remove("hidden");
  const hideAll = () => {
    for (const element of [
      loading,
      notFound,
      disabled,
      pending,
      revoked,
      expired,
      notReady,
      serviceUnavailable,
      profileElement,
      privateDetailsSection,
    ])
      hide(element);
  };
  const setText = (selector, value) => {
    const element = document.querySelector(selector);
    if (element) element.textContent = value;
  };
  const setSectionText = (rowId, valueId, value) => {
    const row = document.querySelector(`#${rowId}`);
    const element = document.querySelector(`#${valueId}`);
    if (!row || !element) return;
    row.classList.remove("hidden");
    element.textContent =
      typeof value === "string" && value.trim() ? value : "Chưa cung cấp";
  };
  const setListText = (rowId, valueId, values) => {
    const row = document.querySelector(`#${rowId}`);
    const element = document.querySelector(`#${valueId}`);
    if (!row || !element) return;
    row.classList.remove("hidden");
    element.textContent =
      Array.isArray(values) && values.length
        ? values.join(", ")
        : "Chưa cung cấp";
  };
  const renderContacts = (contacts) => {
    const container = document.querySelector("#contacts");
    const section = document.querySelector("#contacts-section");
    if (!container || !section) return;
    container.replaceChildren();
    for (const contact of Array.isArray(contacts) ? contacts : []) {
      if (!contact || typeof contact.phone !== "string") continue;
      const card = document.createElement("div");
      card.className = "contact-inner-card";

      const details = document.createElement("div");
      details.className = "contact-details";
      const name = document.createElement("div");
      name.className = "contact-person-name";
      name.textContent = contact.name || "Liên hệ khẩn cấp";
      const relationship = document.createElement("div");
      relationship.className = "contact-relation";
      relationship.textContent = contact.relationship || "Chưa cung cấp";
      details.append(name, relationship);

      const call = document.createElement("a");
      call.className = "btn-call";
      call.href = `tel:${encodeURIComponent(contact.phone)}`;
      call.textContent = "Gọi liên hệ";

      card.append(details, call);
      container.append(card);
    }
    if (container.childElementCount) show(section);
    else hide(section);
  };

  const locationAlertMessages = {
    idle: "",
    locating: "Đang xin quyền truy cập vị trí của bạn…",
    sending: "Đang gửi cảnh báo vị trí…",
    sent: "Đã gửi cảnh báo vị trí đến các liên hệ khẩn cấp.",
    unavailable: "Hiện chưa thể gửi cảnh báo vị trí. Vui lòng thử lại khi cần.",
    cooldown: "Cảnh báo vị trí vừa được xử lý. Vui lòng chờ trước khi gửi lại.",
    rate_limited: "Bạn đã gửi quá nhiều yêu cầu. Vui lòng thử lại sau.",
    permission_denied:
      "Bạn đã từ chối quyền vị trí. Hãy bật quyền vị trí trong trình duyệt nếu muốn thử lại.",
    unsupported: "Trình duyệt này không hỗ trợ chia sẻ vị trí.",
    timeout:
      "Không nhận được vị trí kịp thời. Hãy thử lại ở nơi có tín hiệu tốt hơn.",
    unavailable_position:
      "Không thể xác định vị trí hiện tại. Hãy thử lại sau.",
    invalid_request: "Vị trí nhận được không hợp lệ. Vui lòng thử lại.",
    service_unavailable:
      "Máy chủ tạm thời không thể gửi cảnh báo. Vui lòng thử lại sau.",
    link_unavailable: "Liên kết hồ sơ không còn sẵn sàng để gửi cảnh báo.",
  };

  const setLocationAlertState = (state) => {
    if (!locationAlertStatus) return;
    locationAlertStatus.textContent =
      locationAlertMessages[state] ?? locationAlertMessages.service_unavailable;
    locationAlertStatus.className = `text-center text-xs ${state === "sent" ? "text-success font-semibold" : state === "service_unavailable" || state === "permission_denied" ? "text-danger" : "text-muted"}`;
  };

  const setLocationAlertBusy = (busy, label) => {
    locationAlertBusy = busy;
    if (!sosTriggerButton) return;
    sosTriggerButton.disabled = busy;
    sosTriggerButton.innerHTML = `<svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg> ${label}`;
  };

  const readScannerPosition = () =>
    new Promise((resolve, reject) => {
      navigator.geolocation.getCurrentPosition(resolve, reject, {
        enableHighAccuracy: true,
        maximumAge: 0,
        timeout: 10_000,
      });
    });

  const handleLocationAlert = async () => {
    if (locationAlertBusy) return;
    const token = extractEmergencyToken(window.location.pathname);
    if (!token) {
      setLocationAlertState("link_unavailable");
      return;
    }
    if (typeof navigator === "undefined" || !navigator.geolocation) {
      setLocationAlertState("unsupported");
      return;
    }
    setLocationAlertBusy(true, "Đang xác định vị trí…");
    setLocationAlertState("locating");
    try {
      const position = await readScannerPosition();
      const { latitude, longitude, accuracy } = position.coords;
      if (
        !Number.isFinite(latitude) ||
        !Number.isFinite(longitude) ||
        !Number.isFinite(accuracy) ||
        accuracy <= 0 ||
        latitude < -90 ||
        latitude > 90 ||
        longitude < -180 ||
        longitude > 180
      ) {
        setLocationAlertState("invalid_request");
        return;
      }
      setLocationAlertBusy(true, "Đang gửi cảnh báo…");
      setLocationAlertState("sending");
      const result = await sendPublicEmergencyLocationAlert(token, {
        latitude,
        longitude,
        accuracy_meters: accuracy,
        occurred_at: new Date().toISOString(),
      });
      setLocationAlertState(result.kind);
    } catch (error) {
      if (error && typeof error === "object" && "code" in error) {
        const code = error.code;
        setLocationAlertState(
          code === 1
            ? "permission_denied"
            : code === 2
              ? "unavailable_position"
              : code === 3
                ? "timeout"
                : "service_unavailable",
        );
      } else {
        setLocationAlertState("invalid_request");
      }
    } finally {
      setLocationAlertBusy(false, "Gửi Báo Động SOS");
    }
  };

  sosTriggerButton?.addEventListener("click", () => void handleLocationAlert());

  const clearPrivateDetails = () => {
    hide(privateDetailsUnlocked);
    show(privateDetailsLocked);
    privateDetailsList?.replaceChildren();
    if (privateAccessCode) privateAccessCode.value = "";
    if (privateDetailsError) {
      privateDetailsError.textContent = "";
      hide(privateDetailsError);
    }
    if (privateDetailsPill) {
      privateDetailsPill.textContent = "Yêu cầu mật khẩu";
      privateDetailsPill.classList.remove("sensitive-pill-unlocked");
    }
  };

  const renderPrivateDetails = (privateProfile) => {
    if (!privateDetailsList) return;
    privateDetailsList.replaceChildren();

    const items = [
      ["Chẩn đoán chuyên khoa & Sức khỏe tâm thần", privateProfile.sensitive_conditions.length ? privateProfile.sensitive_conditions.join(", ") : "Chưa cung cấp"],
      ["Địa chỉ", privateProfile.address || "Chưa cung cấp"],
      ["CCCD / mã định danh công dân", privateProfile.citizen_id || "Chưa cung cấp"],
    ];

    for (const [label, value] of items) {
      const item = document.createElement("div");
      item.className = "sensitive-data-item";
      const lbl = document.createElement("div");
      lbl.className = "sensitive-data-label";
      lbl.textContent = label;
      const val = document.createElement("div");
      val.className = "sensitive-data-val";
      val.textContent = value;
      item.append(lbl, val);
      privateDetailsList.append(item);
    }

    hide(privateDetailsLocked);
    show(privateDetailsUnlocked);
    if (privateDetailsPill) {
      privateDetailsPill.textContent = "Đã mở khóa";
      privateDetailsPill.classList.add("sensitive-pill-unlocked");
    }
  };

  const setPrivateError = (message) => {
    if (!privateDetailsError) return;
    if (message) {
      privateDetailsError.textContent = message;
      show(privateDetailsError);
    } else {
      privateDetailsError.textContent = "";
      hide(privateDetailsError);
    }
  };

  const DEMO_PROFILE = {
    profile_id: "demo-profile-01",
    display_name: "Nguyen Van A",
    birth_year: 1950,
    gender: "male",
    blood_type: "B+",
    critical_allergies: ["Penicillin", "Hải Sản"],
    important_conditions: ["Tiểu Đường", "Tăng Huyết Áp"],
    critical_medications: [],
    emergency_note: "",
    emergency_contacts: [
      {
        name: "Nguyen Van B",
        relationship: "Bạn",
        phone: "0901234567",
      },
    ],
    private_profile_envelope: {
      format: "emercard-envelope-v1",
      algorithm: "AES-256-GCM",
      ciphertext: "demo",
    },
  };

  const handlePrivateUnlock = async () => {
    if (
      privateUnlockBusy ||
      !privateEnvelope ||
      !privateProfileId ||
      !privateAccessCode
    )
      return;
    const code = privateAccessCode.value.trim();
    if (code.length < 10 && code !== "emercard2026" && code !== "matkhau" && code !== "passphrase") {
      setPrivateError("Cụm mật khẩu phải có ít nhất 10 ký tự. Vui lòng kiểm tra lại.");
      return;
    }
    privateUnlockBusy = true;
    if (privateUnlockButton) privateUnlockButton.textContent = "Đang giải mã…";
    setPrivateError("");

    if (privateProfileId === "demo-profile-01") {
      if (code === "emercard2026" || code === "matkhau" || code === "passphrase" || code.length >= 10) {
        renderPrivateDetails({
          address: "123 Đường Cứu Hộ, Phường 1, TP. Hồ Chí Minh",
          citizen_id: "079090123456",
          sensitive_conditions: [
            "Rối loạn lo âu lan tỏa (GAD), Tiền sử Viêm gan B",
            "Sertraline 50mg (uống 1 viên vào buổi sáng)",
            "Bệnh nhân dễ kích động hoảng loạn trong không gian hẹp và tiếng ồn lớn. Cần hỗ trợ môi trường thoáng khí khi sơ cứu.",
          ],
        });
        if (privateAccessCode) privateAccessCode.value = "";
        privateUnlockBusy = false;
        if (privateUnlockButton) privateUnlockButton.textContent = "Mở Khóa";
        return;
      }
    }

    try {
      const privateProfile = await decryptPrivateProfileWithAccessCode(
        privateEnvelope,
        privateProfileId,
        code,
      );
      renderPrivateDetails(privateProfile);
      if (privateAccessCode) privateAccessCode.value = "";
    } catch {
      clearPrivateDetails();
      setPrivateError("Cụm mật khẩu không chính xác hoặc dữ liệu bị sửa đổi.");
    } finally {
      privateUnlockBusy = false;
      if (privateUnlockButton)
        privateUnlockButton.textContent = "Mở Khóa";
    }
  };

  privateUnlockButton?.addEventListener(
    "click",
    () => void handlePrivateUnlock(),
  );
  privateAccessCode?.addEventListener("keydown", (event) => {
    if (event.key === "Enter") void handlePrivateUnlock();
  });
  privateLockButton?.addEventListener("click", () => clearPrivateDetails());
  window.addEventListener("pagehide", clearPrivateDetails, { once: true });

  const renderProfile = (profile) => {
    hideAll();
    setText(
      "#display-name",
      typeof profile.display_name === "string" && profile.display_name.trim()
        ? profile.display_name.trim()
        : "Thông tin khẩn cấp",
    );
    const meta = [];
    if (typeof profile.birth_year === "number")
      meta.push(`Năm sinh ${profile.birth_year}`);
    if (typeof profile.gender === "string" && profile.gender)
      meta.push(`Giới tính ${genderLabel(profile.gender)}`);
    setText(
      "#identity-meta",
      meta.length ? meta.join(" • ") : "Chưa cung cấp thêm thông tin định danh",
    );
    setSectionText(
      "blood-type-block",
      "blood-type",
      bloodTypeLabel(
        typeof profile.blood_type === "string" ? profile.blood_type : null,
      ),
    );
    setListText("allergies-row", "allergies", profile.critical_allergies);
    setListText("conditions-row", "conditions", profile.important_conditions);
    setListText("medications-row", "medications", profile.critical_medications);
    setSectionText("note-row", "note", profile.emergency_note);
    renderContacts(profile.emergency_contacts);
    clearPrivateDetails();
    privateEnvelope = profile.private_profile_envelope ?? null;
    privateProfileId = profile.profile_id;
    if (privateEnvelope) show(privateDetailsSection);
    setLocationAlertState("idle");
    setLocationAlertBusy(false, "Gửi Báo Động SOS");
    show(profileElement);
  };

  const renderFailure = (kind) => {
    hideAll();
    const states = {
      not_found: notFound,
      disabled,
      pending,
      revoked,
      expired,
      not_ready: notReady,
    };
    show(states[kind] ?? serviceUnavailable);
  };

  const load = async () => {
    hideAll();
    show(loading);
    const searchParams = new URLSearchParams(window.location.search);
    const isDemo = searchParams.has("demo") || window.location.pathname.endsWith("/demo");
    if (isDemo) {
      return renderProfile(DEMO_PROFILE);
    }
    const token = extractEmergencyToken(window.location.pathname);
    if (!token) return renderFailure("not_found");
    const result = await getPublicEmergencyProfile(token);
    if (result.kind === "available") return renderProfile(result.profile);
    renderFailure(result.kind);
  };

  retryButton?.addEventListener("click", () => void load());
  void load();
</script>
