---
---

<header class="sticky top-0 z-30 border-b border-slate-200/80 bg-white/88 backdrop-blur-md">
  <div class="mx-auto flex min-h-[4.5rem] max-w-7xl items-center justify-between gap-5 px-6 lg:px-8">
    <a href="/" class="flex items-center gap-3" aria-label="Trang chủ EmerCard">
      <img src="/logo.png" alt="EmerCard" class="h-10 w-10 rounded-2xl border border-sky-200 bg-white object-contain shadow-sm" />
      <span class="text-lg font-extrabold tracking-tight text-slate-900">EmerCard</span>
    </a>

    <nav aria-label="Điều hướng chính" class="hidden items-center gap-2 md:flex">
      <a href="/" class="rounded-full px-4 py-2 text-sm font-semibold text-slate-600 transition hover:bg-sky-50 hover:text-sky-700">Trang chủ</a>
      <a href="/blog" class="rounded-full px-4 py-2 text-sm font-semibold text-slate-600 transition hover:bg-sky-50 hover:text-sky-700">Bài viết</a>
      <a href="/login" class="rounded-full px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-100">Đăng nhập</a>
      <a href="/register" class="rounded-full bg-sky-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-sky-700">Tạo tài khoản</a>
    </nav>

    <details class="relative md:hidden">
      <summary class="flex min-h-11 cursor-pointer list-none items-center rounded-full border border-slate-200 px-4 py-2 text-sm font-semibold text-slate-700">
        <span>Menu</span>
      </summary>
      <div class="absolute right-0 top-full z-40 mt-3 w-56 rounded-2xl border border-slate-200 bg-white p-3 shadow-xl">
        <nav aria-label="Điều hướng di động" class="grid gap-1">
          <a href="/" class="rounded-xl px-4 py-3 text-sm font-semibold text-slate-700 hover:bg-sky-50">Trang chủ</a>
          <a href="/blog" class="rounded-xl px-4 py-3 text-sm font-semibold text-slate-700 hover:bg-sky-50">Bài viết</a>
          <a href="/login" class="rounded-xl px-4 py-3 text-sm font-semibold text-slate-700 hover:bg-slate-100">Đăng nhập</a>
          <a href="/register" class="rounded-xl bg-sky-600 px-4 py-3 text-sm font-semibold text-white hover:bg-sky-700">Tạo tài khoản</a>
        </nav>
      </div>
    </details>
  </div>
</header>
